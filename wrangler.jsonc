{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-bookkeeping",
	"main": "server/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cf_bookkeeping_db",
			"database_id": "2e4890f8-4f49-4b78-9739-bcbac17dee9e",
			"migrations_dir": "d1/migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "PHOTOS_BUCKET",
			"bucket_name": "cf-bookkeeping-photos"
		}
	],
	"vars": {
		"JWT_SECRET": "b1uegrey_shared_sso_secret_2026_xyz",
		"ROOT_DOMAIN": "b1uegrey.xyz",
		"AUTH_URL": "https://auth.b1uegrey.xyz"
	},
	"triggers": {
		"crons": [
			"0 1 * * *"
		]
	},
	"routes": [
		{
			"pattern": "book.b1uegrey.xyz",
			"custom_domain": true
		}
	]
}
